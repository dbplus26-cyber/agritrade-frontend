# Origin of the DB Plus API (the agritrade-backend). REQUIRED: src/lib/env.ts
# validates it at import and throws when it is missing, so a misconfigured
# deployment fails at load instead of issuing requests to "undefined/api/v1".
# There is no stub-API fallback - run the backend alongside this app.
NEXT_PUBLIC_SERVER_URI=http://localhost:4060

# Canonical site origin for metadata/sitemap/OG (falls back to production).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cloudflare Turnstile site key for the public forms. Leave EMPTY to disable
# the widget locally (the backend skips verification without its secret key
# too - set BOTH to enforce in production).
# Test always-pass key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only shared secret for the backend's cache purges (POST
# /api/revalidate). Must match REVALIDATE_SECRET in the backend's env.
# Generate with: openssl rand -hex 32. The endpoint fails closed when unset -
# public pages then refresh only on their scheduled ISR windows.
REVALIDATE_SECRET=

# Sentry error reporting. Leave EMPTY to disable the SDK entirely (local dev,
# CI, tests). Events travel through the same-origin /monitoring tunnel, so no
# vendor host enters the CSP. NEXT_PUBLIC_SENTRY_ENVIRONMENT overrides the
# environment tag (defaults to VERCEL_ENV, then NODE_ENV); the release is taken
# from VERCEL_GIT_COMMIT_SHA at build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Build-time only: source-map upload to Sentry. All three must be set for the
# upload to run; with any missing the build skips it and still passes.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog product analytics (EU region). Leave EMPTY to disable. Events travel
# through the same-origin /ingest rewrite in next.config.ts.
NEXT_PUBLIC_POSTHOG_KEY=
